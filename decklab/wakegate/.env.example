# Copy to .env beside compose.yaml and fill in. Never commit .env: it holds the tunnel's token.

# Required: the Deck Lab PC's wired network card (ipconfig /all, "Physical Address", or getmac /v),
# such as 01:23:45:67:89:ab. The stack won't deploy while it's blank.
DECKLAB_PC_MAC=
# Required: the PC's reserved IP address on the home network (give it a DHCP reservation in the
# router so it never changes). Use the address people open Deck Lab by at home: the page only
# sends people through the gate from exactly http://DECKLAB_PC_HOST:DECKLAB_PC_PORT. A .local name
# won't do, since the container can't resolve it.
DECKLAB_PC_HOST=
DECKLAB_PC_PORT=8642

# The gate's own port on the NAS (phones open http://<nas address>:8650).
GATE_PORT=8650

# Where the magic packet goes. The default broadcast works on most home networks; if it doesn't,
# try your network's broadcast address, such as 192.168.1.255.
WOL_BROADCAST=255.255.255.255
WOL_PORT=9

# At most one packet every WAKE_MIN_INTERVAL seconds; the waking page gives up after WAKE_TIMEOUT.
WAKE_MIN_INTERVAL=30
WAKE_TIMEOUT=180

# The NAS tunnel, for visitors from outside (README.md, step 3). Leave both alone until then:
# the gate deploys on its own. Then fill in the token (Cloudflare Zero Trust > Networks > Tunnels >
# the NAS tunnel > Docker), uncomment COMPOSE_PROFILES and deploy again.
# COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=
